ARI_URL=http://127.0.0.1:8088/ari
ARI_USER=zvonko
ARI_PASSWORD=REPLACE_LONG_RANDOM_SECRET
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8766
ADMIN_TOKEN=REPLACE_RANDOM_32_BYTES
MEDIA_HOST=127.0.0.1
SIP_TRUNK=mytrunk
CALLER_ID=+7XXXXXXXXXX
ENABLE_TEST_OUTBOUND=false
TEST_NUMBERS=+7XXXXXXXXXX
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Piper (Denis, ru_RU) is the default for local phone pilot; keep Vosk as optional fallback
TTS_ENGINE=piper
PIPER_VOICE_PATH=~/.local/share/zvonko/voices/ru_RU-denis-medium.onnx
PIPER_LENGTH_SCALE=0.95
SALES_OFFER=профессиональные поломоечные машины VMD
SALES_GOAL=выяснить объект и площадь, способ уборки, предложить подбор с менеджером
TTS_MODEL=vosk-model-tts-ru-0.9-multi
TTS_SPEAKER=2
PRODUCT_INFO=Подбор уборочной техники под площадь и бюджет; цену уточняет менеджер.
MINIMUM_RMS=180
VAD_AGGRESSIVENESS=2
MAX_CALL_SECONDS=240
